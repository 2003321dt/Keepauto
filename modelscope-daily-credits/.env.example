# ===== ModelScope 账号 =====
# 主方式：账号密码（对应 GitHub Secrets 同名变量）
MODELSCOPE_USERNAME=
MODELSCOPE_PASSWORD=

# 兜底方式：浏览器里复制出来的 Cookie 字符串
# 形如 ms_token=xxx; m_session_id=yyy; cna=zzz
# 账号密码登录被滑块风控拦住时用它
MODELSCOPE_COOKIE=

# ===== 行为参数 =====
# 登录成功后等待多少秒再刷新页面（默认 10）
WAIT_SECONDS=10
# 是否有头运行浏览器，本地调试可设为 false 肉眼看过程
HEADLESS=true
# 单次登录后等待登录态的最长秒数
LOGIN_TIMEOUT_SECONDS=90

# ===== 可选通知：Telegram =====
# 1) Telegram 里找 @BotFather 发 /newbot，拿到形如 123456789:AAExxxxx 的 token
# 2) 把 chat id 填进来：给自己的话用 @userinfobot 查数字 id；
#    推群/频道就填 -100xxxxxxxxx 或 @频道用户名（机器人需先被拉进群/设为频道管理员）
# 两项都填了才会推送，缺一个就跳过
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 可选：批量发消息走反代时填（默认官方 https://api.telegram.org）
TELEGRAM_API_BASE=
